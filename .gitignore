# Model weights and generated artefacts.
# evals/photos IS committed: an eval set you cannot reproduce is worthless,
# and 8 MB of fixtures is a fair price for that.
spike/models/
spike/out/
evals/out/
benchmarks/out/

# Fitted parameters ARE committed when they exist: they are inputs the pipeline loads,
# not reports. Neither is present today — both fits were rejected on held-out data.
!benchmarks/fitted_thresholds.json
!benchmarks/eraser_choice.json

# OS
.DS_Store

# pnpm is the package manager (see `packageManager` in package.json). An npm or yarn
# lockfile means someone ran the wrong tool, and two lockfiles describing different trees
# is worse than none — `npm ci` would install something `pnpm-lock.yaml` never sanctioned.
package-lock.json
yarn.lock
