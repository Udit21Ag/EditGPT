# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Nothing here is required to run locally: the gateway and worker fall back to the local
# filesystem, and `docker compose up` supplies Postgres and Redis on the defaults below.
# `GET /ready` names every fallback it is running in.

# ---------------------------------------------------------------- infrastructure
# Defaults match docker-compose.yml. Override only to point somewhere else.
EDITGPT_DATABASE_URL=postgresql+psycopg://editgpt:editgpt@localhost:5432/editgpt
EDITGPT_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- authentication
# Clerk. The SECRET key's presence is what switches authentication on: without it every
# request acts as one shared anonymous account, and `GET /ready` says so out loud.
#
# Where to get these: dashboard.clerk.com -> create an application -> API Keys.
# No payment details are asked for on the free tier.
#
# These two names are Clerk's own, and the gateway reads them unprefixed on purpose: the
# Next.js SDK requires these exact names, so one variable serves both processes rather
# than the same secret living in two places waiting to be rotated in only one.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The instance's PEM public key, from API Keys -> "Show JWT public key".
# Optional but strongly preferred: with it, session verification is local arithmetic.
# Without it the first request after every deploy waits on Clerk's JWKS endpoint.
# Keep the -----BEGIN PUBLIC KEY----- header, and quote it if it spans lines.
CLERK_JWT_KEY=

# Origins whose tokens this gateway accepts, as a JSON list, e.g.
# ["https://editgpt.example"]. Empty accepts any party — fine locally, not in production.
EDITGPT_CLERK_AUTHORIZED_PARTIES=

# Where the browser reaches the gateway.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# A user for `make e2e` to sign in as. Optional: without it the signed-in browser flows
# skip and the rest of the suite still runs, the same way the `service` tests skip with no
# Postgres. Clerk cannot conjure a session without an account to be, so this is a real user
# in the development instance.
#
# Prefer an address containing "+clerk_test", e.g. e2e+clerk_test@example.com. Clerk treats
# those as test accounts and accepts the fixed code 424242, so **no password is needed and
# none is stored**. Clerk also refuses any password found in a breach corpus, which is hard
# to satisfy with one that has to live in a file.
CLERK_E2E_EMAIL=
# Only for an ordinary address. Leave empty when using a +clerk_test one.
CLERK_E2E_PASSWORD=

# ---------------------------------------------------------------- generative lane
# Additions and replacements. The token needs Workers AI *Edit* and *Read*; Read alone 401s.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Intent parsing and critique. Text models only — the image API has no free tier.
GEMINI_API_KEY=

# ---------------------------------------------------------------- object storage
# Optional, and vendor-neutral: anything speaking the S3 API works, because the endpoint
# is configuration rather than something baked into the code. Leave the endpoint empty to
# keep assets on local disk under EDITGPT_ASSET_ROOT.
#
# Storage switches over only when the endpoint, the bucket AND an access key are all set,
# so a half-filled file cannot quietly send a deployment's artifacts to somebody's laptop.
#
# LOCAL, needs no account at all — `make compose-s3` starts MinIO:
#   EDITGPT_S3_ENDPOINT_URL=http://localhost:9000
#   EDITGPT_S3_BUCKET=editgpt-assets
#   EDITGPT_S3_ACCESS_KEY_ID=editgpt
#   EDITGPT_S3_SECRET_ACCESS_KEY=editgpt-dev-secret
#   EDITGPT_S3_REGION=us-east-1
#
# HOSTED: see docs/RUNBOOK.md for options that do not ask for payment details.
EDITGPT_S3_ENDPOINT_URL=
EDITGPT_S3_BUCKET=
EDITGPT_S3_ACCESS_KEY_ID=
EDITGPT_S3_SECRET_ACCESS_KEY=
EDITGPT_S3_REGION=auto
